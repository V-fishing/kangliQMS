{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "preserve",
    "verbatimModuleSyntax": false,

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    "types": ["vite/client", "node", "element-plus/global"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "src/api/modules/auth.ts",
    "src/api/modules/fia.ts",
    "src/api/modules/ncm.ts",
    "src/api/modules/overview.ts",
    "src/api/modules/qsm.ts",
    "src/api/modules/spc.ts",
    "src/api/modules/sqm.ts",
    "src/api/modules/system.ts",
    "src/api/modules/tlm.ts",
    "src/mock/**",
    "dist/**",
    "node_modules/**"
  ]
}
